# ============================================================================
# 测试环境配置 —— env/.env.test
# 加载方式：pnpm allDev --env test（或 pnpm allDev:test）
# 与开发环境刻意使用不同端口与库名，便于两套环境在同一台机器上并存
# ============================================================================

# ---------------------------- 运行环境 ----------------------------
APP_ENV=test

# ---------------------------- 服务地址 ----------------------------
PUBLIC_HOST=localhost
# API_BASE=http://localhost:3101/geoserver

# ---------------------------- 端口 ----------------------------
# 测试环境错开开发端口，避免 allDev 与 allDev:test 互相抢占
PORT_SERVER=3101
PORT_ADMIN=3100
PORT_GEO=3102

# ---------------------------- 数据库 ----------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=111
# 测试库独立于开发库，迁移与压测数据不污染开发数据
DB_NAME=trillionCms_test

# ---------------------------- 服务端 ----------------------------
JWT_SECRET=trillion-cms-test-secret-please-change
JWT_EXPIRES_IN=2h
UPLOAD_DIR=uploads
PUBLIC_URL_PREFIX=/static

# ---------------------------- 前端 ----------------------------
NUXT_PUBLIC_SITE_SLUG=star-tech
