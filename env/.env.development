# ============================================================================
# 开发环境配置 —— env/.env.development
# 加载方式：由根启动器 / 执行器统一加载（pnpm allDev / pnpm dev:server ...）
# 注意：各应用不再自带 .env，此处是全平台唯一的环境变量来源
# 全量变量含义见 env/.env.example 与 docs/spec/07-deployment.md §3
# ============================================================================

# ---------------------------- 运行环境 ----------------------------
APP_ENV=development

# ---------------------------- 服务地址 ----------------------------
# 生成 API 基址与前端访问地址所用的主机名
# 用 127.0.0.1 而非 localhost：localhost 会被浏览器优先解析为 IPv6 ::1，
# 而服务端监听 IPv4 0.0.0.0（ADR-021），用 localhost 会导致请求 Failed to fetch
PUBLIC_HOST=127.0.0.1

# 服务端 API 基址：留空则统一为 /geoserver（直连服务端时可填 http://127.0.0.1:3001/geoserver）
# API_BASE=

# 跨域白名单：留空则由 PORT_ADMIN / PORT_GEO 派生（并追加本机局域网 IP）
# 显式填写后不再追加局域网来源，故需完整列出：3000/3002 双回环写法 + 4173 静态产物预览（09 §12.5）
# 局域网设备联调时，把 http://<本机IP>:3000 / :3002 追加到本行
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3002,http://localhost:3002,http://127.0.0.1:4173,http://localhost:4173

# ---------------------------- 端口 ----------------------------
# 留空即使用 config/ports.mjs 的默认值（server 3001 / admin 3000 / geo 3002）
# PORT_SERVER=3001
# PORT_ADMIN=3000
# PORT_GEO=3002

# ---------------------------- 数据库 ----------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=111
DB_NAME=trillionCms
# 连接串：留空则由上面 5 个变量拼装（密码含 @ ! # 等字符会自动百分号编码）
# DATABASE_URL=

# ---------------------------- 服务端 ----------------------------
# 管理后台鉴权密钥（生产必须更换为 32 位以上随机串）
JWT_SECRET=trillion-cms-dev-secret-please-change
JWT_EXPIRES_IN=7d
# 上传文件物理目录与对外 URL 前缀
UPLOAD_DIR=uploads
PUBLIC_URL_PREFIX=/static

# ---------------------------- 前端 ----------------------------
# 本地无域名时识别站点用（SSG 构建与本地预览），SSR 模式按请求 Host 解析
NUXT_PUBLIC_SITE_SLUG=xian-renai-skin

# 站点访问埋点开关（sendBeacon 上报 /track/collect）：1 = 开启；留空或 0 = 关闭（功能保留，默认不注入）
NUXT_PUBLIC_TRACK_ENABLED=0
