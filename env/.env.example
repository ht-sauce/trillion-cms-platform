# ============================================================================
# 环境变量模板 —— env/.env.example
#
# 用法：
#   copy env/.env.example env/.env.production      # Windows
#   cp   env/.env.example env/.env.production      # macOS / Linux
#   pnpm dev --env production                   # 指定环境启动
#
# 规则：
# - 运行环境名（development / test / production）决定加载 env/.env.<名字>
# - 端口、API 基址、CORS 白名单、数据库连接串均可留空，由 config/ 派生
# - 本文件只作模板与说明，不参与任何启动流程
# ============================================================================

# ---------------------------- 运行环境 ----------------------------
# 与文件名一致即可（--env 参数优先于本项）
APP_ENV=production

# ---------------------------- 服务地址 ----------------------------
# 用于生成 API 基址与前端地址；跨机部署时填域名或内网 IP
PUBLIC_HOST=localhost

# 服务端 API 基址（留空 = http://<PUBLIC_HOST>:<PORT_SERVER>/geoserver 自动派生；反向代理/远端域名场景显式指定）
# API_BASE=https://api.example.com/geoserver

# GEO 预览基址（后台内容编辑器 iframe 与站点列表「预览」按钮的地址前缀，ADR-049；SSG 产物自检亦用）
# 预览地址 = 本基址 + /<slug>?__preview=<票据>，永不打开站点正式域名
# 留空 = 按 PUBLIC_HOST + PORT_GEO 派生（仅本机开发可用，即 local 方式）
# 线上必须显式填写 nginx 对外入口，例：
# GEO_BASE_URL=http://11.11.11.11:3081

# 跨域白名单，逗号分隔（留空 = 由 PORT_ADMIN / PORT_GEO 派生，并追加本机局域网 IP 的同端口来源）
# 注意：显式填写后不再追加局域网来源，开发期如需手机/其他电脑访问，请自行把 http://<本机IP>:3000 / :3002 写进来
# CORS_ORIGINS=https://admin.example.com,https://www.example.com

# ---------------------------- 端口 ----------------------------
# 留空即取 config/ports.mjs 默认值：server 3001 / admin 3000 / geo 3002
# PORT_SERVER=3001
# PORT_ADMIN=3000
# PORT_GEO=3002

# ---------------------------- 数据库 ----------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trillionCms
# 显式连接串优先于上面 5 个变量；容器部署时形如 mysql://user:pwd@mysql:3306/trillionCms
# DATABASE_URL=

# ---------------------------- 服务端 ----------------------------
# 管理后台鉴权密钥：生产必须使用 32 位以上随机串
JWT_SECRET=
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
PUBLIC_URL_PREFIX=/static

# ---------------------------- 前端 ----------------------------
# SSG 构建 / 本地预览时识别站点用；SSR 模式按请求 Host 解析站点
NUXT_PUBLIC_SITE_SLUG=

# 站点访问埋点开关（sendBeacon 上报 /track/collect）：1 = 开启；留空或 0 = 关闭（功能保留，默认不注入）
NUXT_PUBLIC_TRACK_ENABLED=0

# GEO 统一入口的站点产物根目录（ADR-045）：缺省 <apps/geo>/sites（release / PM2 的 cwd 均为 apps/geo），一般无需配置
# SITE_PRODUCTS_DIR=

# ---------------------------- 入站监控 / 需求收集 ----------------------------
# 可信代理 CIDR（逗号分隔）：只有直连对端 IP 命中时才解析 X-Forwarded-For / X-Forwarded-Proto，
# 并按代理链从右向左定位客户端；未配置或配置错误时一律不信任转发头（不猜测线上拓扑）。
# 例：TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8,::1/128
# TRUSTED_PROXIES=

# DB-IP City Lite 离线 MMDB 路径（相对服务端工作目录 apps/server，或绝对路径）。
# 数据许可 CC BY 4.0，需保留「IP Geolocation by DB-IP」署名；文件缺失时地域留空，不影响访问日志保存。
# DBIP_CITY_MMDB=data/dbip-city-lite.mmdb
