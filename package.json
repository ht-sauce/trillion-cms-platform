{
  "name": "trillion-cms-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@>=9.0.0",
  "description": "多站点 CMS 平台：apps/admin 管理后台 + apps/geo GEO 项目 + apps/server 服务端",
  "packageManagerStrict": false,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "db": "node scripts/db.mjs",
    "site": "node scripts/site.mjs",
    "release": "node scripts/release.mjs",
    "bundle": "node scripts/pack-deploy.mjs",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,vue,scss,json,md,mjs}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
